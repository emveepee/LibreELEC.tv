<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
  <section id="service.yauiclient">
    <category id="settings" label="30000" help="">
      <group id="1">
        <setting id="host" type="string" label="30001" help="">
          <default>127.0.0.1</default>
          <control type="edit" format="string"></control>
        </setting>
        <setting id="port" type="integer" label="30002" help="">
          <default>8866</default>
          <control type="edit" format="number"></control>
        </setting>
        <setting id="pin" type="string" label="30003" help="">
          <default>0000</default>
          <control type="edit" format="string"></control>
        </setting>
        <setting id="resolution" type="string" label="30004" help="">
          <default>1280x720</default>
          <constraints>
            <options>
              <option>1280x720</option>
              <option>1366x768</option>
              <option>1920x1080</option>
              <option>3840x2160</option>
            </options>
          </constraints>
          <control type="list" format="string" />
        </setting>
        <setting id="deinterlace" type="boolean" label="30005" help="">
          <level>2</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="lirc" type="boolean" label="30006" help="">
          <level>2</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
    <category id="sync" label="30007">
      <group id="2">
        <setting id="syncaudio" type="action" label="30008" help="30009">
          <level>1</level>
          <data>RunScript(service.yauiclient, syncaudio)</data>
          <control type="button" format="action">
            <close>false</close>
          </control>
        </setting>
        <setting id="shutdown" type="boolean" label="30010" help="30011">
          <level>2</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="autostart" type="action" label="30012" help="30013">
          <level>2</level>
          <data>RunScript(service.yauiclient, autostart)</data>
          <control type="button" format="action">
            <close>false</close>
          </control>
        </setting>
        <setting id="x11config" type="action" label="30014" help="30015">
          <level>2</level>
          <data>RunScript(service.yauiclient, x11config)</data>
          <control type="button" format="action">
            <close>false</close>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>